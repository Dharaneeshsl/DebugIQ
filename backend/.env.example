# Local installation needs no external database or queue.
DEBUGIQ_STORAGE=sqlite
DEBUGIQ_EMBEDDINGS_BACKEND=tfidf
DEBUGIQ_ALLOW_EXTERNAL_AI=false
DEBUGIQ_ADMIN_USERNAME=admin
DEBUGIQ_ADMIN_PASSWORD=admin123
# Set a long random secret before sharing this installation.
DEBUGIQ_JWT_SECRET=replace-with-a-long-random-secret
DEBUGIQ_MAX_UPLOAD_BYTES=20971520
# Optional shared services:
# DEBUGIQ_STORAGE=mongo
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=debugiq
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Optional AI provider (rule-based assistance works without a key):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# CORS_ALLOWED_ORIGINS=https://your-frontend.example
